# =========================================================
# Environment variables
# =========================================================
# Block all .env files by default
.env
.env.*
# Allow the committed template (no real secrets inside)
!.env.example
# Block Vercel-pulled local env files (may contain sensitive tokens)
.env.local
.env*.local

# =========================================================
# Vite
# =========================================================
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

